<svg width="600" height="600" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bestsellery - Najprodavaniji Proizvodi">
  <defs>
    <linearGradient id="catBest" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7c2d12"/>
      <stop offset="100%" style="stop-color:#9a3412"/>
    </linearGradient>
    <linearGradient id="catBestAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#fbbf24"/>
      <stop offset="50%" style="stop-color:#f59e0b"/>
      <stop offset="100%" style="stop-color:#fbbf24"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#catBest)"/>
  <g opacity="0.05">
    <pattern id="patternBest" width="45" height="45" patternUnits="userSpaceOnUse">
      <polygon points="22.5,0 30,15 45,15 34.5,22.5 37.5,37.5 22.5,30 7.5,37.5 10.5,22.5 0,15 15,15" fill="none" stroke="white" stroke-width="0.8"/>
    </pattern>
    <rect width="600" height="600" fill="url(#patternBest)"/>
  </g>
  <g transform="translate(300, 300)" text-anchor="middle">
    <text font-family="system-ui, sans-serif" font-size="48" fill="white" font-weight="700">Bestsellery</text>
    <text x="0" y="60" font-family="system-ui, sans-serif" font-size="20" fill="rgba(255,255,255,0.7)">Najprodavaniji • Verifikovano kvalitetom</text>
    <text x="0" y="100" font-family="system-ui, sans-serif" font-size="16" fill="url(#catBestAccent)" font-weight="600">Kupci ove proizvode vole najvise</text>
  </g>
  <circle cx="300" cy="500" r="80" fill="none" stroke="url(#catBestAccent)" stroke-width="2" opacity="0.3"/>
  <text x="300" y="506" font-family="system-ui, sans-serif" font-size="32" fill="url(#catBestAccent)" text-anchor="middle" opacity="0.5">🔥</text>
</svg>