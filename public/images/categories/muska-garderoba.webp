<svg width="600" height="600" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Muška Garderoba - Majice, Trenerke, Duksevi">
  <defs>
    <linearGradient id="catMuski" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3a5f"/>
      <stop offset="100%" style="stop-color:#1e40af"/>
    </linearGradient>
    <linearGradient id="catMuskiAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#3b82f6"/>
      <stop offset="100%" style="stop-color:#2563eb"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#catMuski)"/>
  <g opacity="0.05">
    <pattern id="patternMuski" width="60" height="60" patternUnits="userSpaceOnUse">
      <path d="M 30 0 L 60 30 L 30 60 L 0 30 Z" fill="none" stroke="white" stroke-width="1"/>
    </pattern>
    <rect width="600" height="600" fill="url(#patternMuski)"/>
  </g>
  <g transform="translate(300, 300)" text-anchor="middle">
    <text font-family="system-ui, sans-serif" font-size="48" fill="white" font-weight="700">Muška Garderoba</text>
    <text x="0" y="60" font-family="system-ui, sans-serif" font-size="20" fill="rgba(255,255,255,0.7)">Majice • Trenerke • Duksevi</text>
    <text x="0" y="100" font-family="system-ui, sans-serif" font-size="16" fill="url(#catMuskiAccent)" font-weight="600">Muški kroš • Gruba pamuk 320g/m²</text>
  </g>
  <circle cx="300" cy="500" r="80" fill="none" stroke="url(#catMuskiAccent)" stroke-width="2" opacity="0.3"/>
  <text x="300" y="506" font-family="system-ui, sans-serif" font-size="32" fill="url(#catMuskiAccent)" text-anchor="middle" opacity="0.5">👨</text>
</svg>