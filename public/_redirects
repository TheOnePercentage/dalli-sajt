# 301 Redirects for Luxury Collection Migration
# Generated from old product URLs to new collection-based URLs
# Place in .htaccess or Netlify _redirects

# --- API: orders (real, Blobs-backed) - storefront + admin ---
/api/orders/*                 /.netlify/functions/orders  200
/api/orders                   /.netlify/functions/orders  200
/api/v1/admin/orders/*        /.netlify/functions/orders  200
/api/v1/admin/orders          /.netlify/functions/orders  200
# --- API: product visibility (storefront overlay + admin) ---
/api/products-visibility                /.netlify/functions/products-visibility  200
/api/v1/admin/products-visibility/*     /.netlify/functions/products-visibility  200
/api/v1/admin/products-visibility       /.netlify/functions/products-visibility  200
# --- API: analytics (storefront tracking + admin reporting) ---
/api/analytics/*                        /.netlify/functions/analytics  200
/api/analytics                          /.netlify/functions/analytics  200
/api/v1/admin/analytics/*               /.netlify/functions/analytics  200
/api/v1/admin/analytics                 /.netlify/functions/analytics  200
# --- API: social metrics (admin) ---
/api/v1/admin/social-metrics/*          /.netlify/functions/social-metrics  200
/api/v1/admin/social-metrics            /.netlify/functions/social-metrics  200

