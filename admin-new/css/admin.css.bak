/* ==========================================================================
   DALLI ADMIN — Main Stylesheet
   Imports all modular CSS components
   ========================================================================== */

/* Core — Design Tokens & Layout */
@import './core/variables.css';
@import './core/layout.css';
@import './core/responsive-dark.css';

/* Components — Base */
@import './components/forms.css';
@import './components/tables.css';
@import './components/cards-modals.css';
@import './components/charts-widgets.css';
@import './components/alert-banner.css';
@import './components/command-palette.css';

/* Components — Luxury Shared */
@import './components/luxury-stat-cards.css';
@import './components/luxury-empty-states.css';
@import './components/luxury-skeletons.css';
@import './components/luxury-modals.css';
@import './components/luxury-dropdowns.css';
@import './components/luxury-badges.css';
@import './components/luxury-tooltips.css';
@import './components/luxury-tabs.css';
@import './components/luxury-avatars.css';
@import './components/luxury-pagination.css';
@import './components/luxury-breadcrumbs.css';

/* Sections — Luxury Dashboards */
@import './sections/analytics.css';
@import './sections/products.css';
@import './sections/categories.css';
@import './sections/customers.css';
@import './sections/reviews.css';
@import './sections/orders.css';
@import './sections/inventory.css';
@import './sections/promotions.css';
@import './sections/campaigns.css';
@import './sections/seo.css';
@import './sections/social.css';
@import './sections/social-media.css';
@import './sections/budget-pacing.css';
@import './sections/profit.css';
@import './sections/growth.css';
@import './sections/executive.css';
@import './sections/diagnostics.css';
@import './sections/settings.css';
@import './sections/roles.css';
@import './sections/products-cms.css';
@import './sections/markets.css';
@import './sections/accounting.css';
@import './sections/search-analytics.css';

/* ==========================================================================
   ADMIN PANEL LAYOUT FIXES
   ========================================================================== */

/* Make alert banner static (not fixed) so it flows with content */
.app .alert-banner,
.app .dalli-happy-state {
  position: static !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  z-index: auto !important;
}

/* Mobile responsiveness - max-width 768px */
@media (max-width: 768px) {
  /* Mobile sidebar toggle button */
  .mobile-sidebar-toggle {
    display: block;
    padding: var(--space-3);
    background: var(--color-primary);
    color: white;
    cursor: pointer;
    z-index: 1001;
    position: fixed;
    top: var(--topbar-height);
    left: var(--space-4);
    border-radius: var(--radius);
    backdrop-filter: blur(4px);
  }
  
  /* App shell adjustments for mobile */
  .app-shell {
    position: relative;
    margin-top: var(--topbar-height);
    contain: layout;
  }
  
  /* Sidebar - hidden on mobile, shown via overlay */
  .sidebar {
    position: fixed;
    top: var(--topbar-height);
    left: 0;
    width: var(--sidebar-width);
    height: calc(100vh - var(--topbar-height));
    z-index: 1000;
    transform: translateX(-100%);
    transition: transform var(--transition-smooth);
    overflow-y: auto;
    background: var(--color-bg-card);
    border-right: none;
    border-bottom: 1px solid var(--color-border-primary);
    padding: var(--space-4) var(--space-3);
    padding-bottom: var(--space-8);
  }
  
  /* Sidebar open state (added via JS class) */
  .sidebar.open {
    transform: translateX(0);
  }
  
  /* Sidebar overlay */
  .sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 999;
    backdrop-filter: blur(4px);
  }
  
  .sidebar-overlay.open {
    display: block;
  }
  
  /* Sidebar Navigation Styles */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .nav-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  
  .nav-section-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    padding: var(--space-1) var(--space-2);
    margin-top: var(--space-2);
  }
  
  .nav-section:first-child .nav-section-title {
    margin-top: 0;
  }
  
  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: all var(--transition-fast);
    white-space: nowrap;
    overflow: hidden;
  }
  
  .nav-item:hover {
    background: var(--color-primary-100);
    color: var(--color-primary);
  }
  
  .nav-item.active {
    background: var(--color-primary-100);
    color: var(--color-primary);
    font-weight: 600;
  }
  
  .nav-item:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  
  .nav-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    stroke: currentColor;
  }
  
  .nav-badge {
    margin-left: auto;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 600;
    border-radius: 999px;
    background: var(--color-primary-100);
    color: var(--color-primary);
  }
  
  .nav-badge.warning {
    background: var(--color-warning-100);
    color: var(--color-warning);
  }
  
  .nav-badge.danger {
    background: var(--color-error-100);
    color: var(--color-error);
  }
  
  .sidebar-footer {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-primary);
  }
  
  .user-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
  }
  
  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    color: white;
  }
  
  .avatar-primary { background: var(--color-primary); }
  .avatar-success { background: var(--color-success); }
  .avatar-warning { background: var(--color-warning); }
  .avatar-error { background: var(--color-error); }
  
  .user-details {
    flex: 1;
    min-width: 0;
  }
  
  .user-name {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .user-role {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  
  .sidebar-toggle {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border-primary);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10;
  }
  
  .sidebar-toggle:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }
  
  /* Collapsed sidebar styles */
  .sidebar.collapsed .brand-text,
  .sidebar.collapsed .nav-section-title,
  .sidebar.collapsed .nav-item span,
  .sidebar.collapsed .nav-badge,
  .sidebar.collapsed .sidebar-footer,
  .sidebar.collapsed .sidebar-brand {
    display: none;
  }
  
  .sidebar.collapsed .nav-item {
    justify-content: center;
    padding: var(--space-2);
  }
  
  .sidebar.collapsed .sidebar-nav {
    align-items: center;
  }
  
  .sidebar.collapsed .sidebar-toggle {
    display: flex;
  }

  
  /* Topbar adjustments for mobile - full width, primary color */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1010;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-primary);
    color: white;
    border-bottom: 1px solid rgba(255,255,255,0.2);
  }
  
  /* Topbar left - logo area */
  .topbar .topbar-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    width: 100%;
  }
  
  .topbar .topbar-left .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  
  .topbar .topbar-left span {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: white;
    display: block;
  }
  
  .topbar .topbar-left svg {
    width: 32px;
    height: 32px;
  }
  
  /* Topbar right - menu items */
  .topbar .topbar-right {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-3);
    background: rgba(255,255,255,0.1);
    border-radius: var(--radius);
    backdrop-filter: blur(4px);
  }
  
  /* Hamburger menu button on topbar */
  .topbar .mobile-menu-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: rgba(255,255,255,0.2);
    border-radius: var(--radius);
    color: white;
    border: none;
    backdrop-filter: blur(4px);
    font-size: var(--text-sm);
  }
  
  .topbar .mobile-menu-btn:hover {
    background: rgba(255,255,255,0.3);
  }
  
  /* Main content - full width on mobile */
  .main-content {
    margin-top: calc(var(--topbar-height) + var(--space-4));
    padding: var(--space-4) var(--space-3);
    width: 100%;
    min-height: calc(100vh - var(--topbar-height) - var(--space-4));
  }
  
  /* Focus visible for accessibility */
  .sidebar-nav a:focus-visible,
  .topbar button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  
  /* Hide secondary actions on mobile */
  .topbar .theme-toggle {
    display: none;
  }
  
  .topbar .cart-link {
    display: none;
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none;
    }
    .app {
      transition: none;
  }
}

/* ============================================================
   PRODUCTS CMS SECTION
   ============================================================ */
.products-cms-section {
  padding: var(--space-4);
}

.filters-bar {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  padding: var(--space-3);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-4);
}

.filter-group {
  flex: 1;
  min-width: 200px;
}

.search-input {
  width: 100%;
  padding: var(--space-2) var(--space-3);
  font-size: var(--fs-sm);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.select-field {
  width: 100%;
  padding: var(--space-2) var(--space-3);
  font-size: var(--fs-sm);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.table-container {
  overflow-x: auto;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--fs-sm);
}

.data-table th,
.data-table td {
  padding: var(--space-3) var(--space-4);
  text-align: left;
  border-bottom: 1px solid var(--color-divider);
}

.data-table th {
  background: var(--color-bg-subtle);
  font-weight: var(--font-semibold);
  color: var(--color-text-secondary);
  white-space: nowrap;
  cursor: pointer;
  user-select: none;
}

.data-table th:hover {
  background: var(--color-bg);
}

.data-table th svg {
  width: 14px;
  height: 14px;
  margin-left: var(--space-1);
  vertical-align: middle;
  opacity: 0.5;
}

.data-table tr:hover td {
  background: var(--color-bg-subtle);
}

.data-table .text-center {
  text-align: center;
}

.action-buttons {
  display: flex;
  gap: var(--space-1);
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-3);
  flex-wrap: wrap;
}

.pagination-info {
  font-size: var(--fs-sm);
  color: var(--color-text-secondary);
}

.section-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-divider);
}

.section-header-main h2 {
  margin: 0;
  font-size: var(--fs-xl);
  font-weight: var(--font-bold);
}

.section-header-main p {
  margin: var(--space-1) 0 0;
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
}

.section-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
}

.quick-ranges {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.products-cms-section .filters-bar {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: flex-end;
}

.products-cms-section .filter-group {
  flex: 1;
  min-width: 180px;
}

.products-cms-section .search-input {
  width: 100%;
}

.markets-section {
  padding: var(--space-4);
}

.accounting-section {
  padding: var(--space-4);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.stat-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  transition: transform var(--duration-fast), box-shadow var(--duration-fast);
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--elevation-3);
}

.stat-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  flex-shrink: 0;
}

.stat-icon.revenue { background: var(--color-success); }
.stat-icon.refunds { background: var(--color-error); }
.stat-icon.fees { background: var(--color-warning); }
.stat-icon.profit { background: var(--color-primary); }

.stat-content {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: var(--fs-xs);
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.stat-value {
  font-size: var(--fs-xl);
  font-weight: var(--font-bold);
  line-height: 1.2;
}

.chart-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.chart-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.chart-card.full-width {
  grid-column: 1 / -1;
}

.chart-card h3 {
  margin: 0 0 var(--space-3);
  font-size: var(--fs-lg);
  font-weight: var(--font-semibold);
}

.chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-subtle);
  border-radius: var(--radius-md);
}

.chart-skeleton {
  width: 100%;
  height: 100%;
}

.pie-chart-skeleton {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: conic-gradient(var(--color-primary) 0%, var(--color-accent) 25%, var(--color-success) 50%, var(--color-warning) 75%, var(--color-primary) 100%);
}

.reports-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-4);
  margin-top: var(--space-4);
}

.report-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  text-align: center;
  transition: transform var(--duration-fast), box-shadow var(--duration-fast);
}

.report-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--elevation-3);
  border-color: var(--color-primary);
}

.report-card h3 {
  margin: 0 0 var(--space-2);
  font-size: var(--fs-lg);
}

.report-card p {
  margin: 0 0 var(--space-4);
  color: var(--color-text-secondary);
  font-size: var(--fs-sm);
}

.tax-summary {
  margin-bottom: var(--space-6);
}

.tax-periods {
  margin-top: var(--space-6);
}

.tax-periods h3 {
  margin: 0 0 var(--space-3);
  font-size: var(--fs-lg);
}

.markets-section .section-header,
.accounting-section .section-header {
  margin-bottom: var(--space-4);
}

.markets-section .stat-grid,
.accounting-section .stat-grid {
  margin-bottom: var(--space-4);
}

.markets-section .chart-grid,
.accounting-section .chart-grid {
  margin-top: var(--space-4);
}

.tax-summary .stat-grid {
  margin-bottom: var(--space-4);
}

.tax-periods .table-container {
  margin-top: var(--space-3);
}

.markets-section .table-container,
.accounting-section .table-container {
  margin-top: var(--space-3);
}

.chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  background: var(--color-bg-subtle);
  border-radius: var(--radius-md);
}

.chart-skeleton {
  width: 100%;
  height: 100%;
}

.market-form .form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}

.market-form .form-group {
  margin-bottom: 0;
}

.quick-ranges .btn {
  flex-shrink: 0;
}

.quick-ranges .btn.active {
  background: var(--color-primary);
  color: white;
}

.export-dropdown .dropdown-menu {
  min-width: 180px;
}

.tax-summary .stat-card {
  border-left: 4px solid var(--color-primary);
}

.tax-summary .stat-card:nth-child(2) {
  border-left-color: var(--color-warning);
}

.tax-periods .table-container {
  margin-top: var(--space-3);
}

.markets-section .table-container,
.accounting-section .table-container {
  margin-top: var(--space-3);
}

.chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  background: var(--color-bg-subtle);
