}

.chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  background: var(--color-bg-subtle);
  border-radius: var(--radius-md);
}

.chart-skeleton {
  width: 100%;
  height: 100%;
}

/* Skeleton animations */
@keyframes skeletonPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 0.8; }
}

.skeleton-stat {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.skeleton-stat > div {
  height: 100px;
  background: linear-gradient(90deg, var(--color-bg-subtle) 25%, var(--color-border) 50%, var(--color-bg-subtle) 75%);
  background-size: 200% 100%;
  animation: skeletonPulse 1.5s ease-in-out infinite;
  border-radius: var(--radius-lg);
}

.chart-skeleton {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: var(--space-4);
}

.chart-skeleton > div {
  height: 300px;
  background: linear-gradient(90deg, var(--color-bg-subtle) 25%, var(--color-border) 50%, var(--color-bg-subtle) 75%);
  background-size: 200% 100%;
  animation: skeletonPulse 1.5s ease-in-out infinite;
  border-radius: var(--radius-lg);
}

.table-skeleton {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.table-skeleton > div {
  height: 50px;
  background: linear-gradient(90deg, var(--color-bg-subtle) 25%, var(--color-border) 50%, var(--color-bg-subtle) 75%);
  background-size: 200% 100%;
  animation: skeletonPulse 1.5s ease-in-out infinite;
  border-bottom: 1px solid var(--color-divider);
}

.table-skeleton > div:last-child {
  border-bottom: none;
}

.products-grid-skeleton {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--space-4);
}

.products-grid-skeleton > div {
  height: 350px;
  background: linear-gradient(90deg, var(--color-bg-subtle) 25%, var(--color-border) 50%, var(--color-bg-subtle) 75%);
  background-size: 200% 100%;
  animation: skeletonPulse 1.5s ease-in-out infinite;
  border-radius: var(--radius-lg);
}

.chart-skeleton {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: var(--space-4);
}

.chart-skeleton > div {
  height: 300px;
  background: linear-gradient(90deg, var(--color-bg-subtle) 25%, var(--color-border) 50%, var(--color-bg-subtle) 75%);
  background-size: 200% 100%;
  animation: skeletonPulse 1.5s ease-in-out infinite;
  border-radius: var(--radius-lg);
}

/* ============================================================
   MARKETS SECTION
   ============================================================ */
.markets-section .section-header,
.accounting-section .section-header {
  margin-bottom: var(--space-4);
}

.markets-section .stat-grid,
.accounting-section .stat-grid {
  margin-bottom: var(--space-4);
}

.markets-section .chart-grid,
.accounting-section .chart-grid {
  margin-top: var(--space-4);
}

.tax-summary .stat-grid {
  margin-bottom: var(--space-4);
}

.tax-periods .table-container {
  margin-top: var(--space-3);
}

.markets-section .table-container,
.accounting-section .table-container {
  margin-top: var(--space-3);
}

.chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  background: var(--color-bg-subtle);
  border-radius: var(--radius-md);
}

.chart-skeleton {
  width: 100%;
  height: 100%;
}

.market-form .form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}

.market-form .form-group {
  margin-bottom: 0;
}

.quick-ranges .btn {
  flex-shrink: 0;
}

.quick-ranges .btn.active {
  background: var(--color-primary);
  color: white;
}

.export-dropdown .dropdown-menu {
  min-width: 180px;
}

.tax-summary .stat-card {
  border-left: 4px solid var(--color-primary);
}

.tax-summary .stat-card:nth-child(2) {
  border-left-color: var(--color-warning);
}

.tax-periods .table-container {
  margin-top: var(--space-3);
}

