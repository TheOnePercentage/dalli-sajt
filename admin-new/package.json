{
  "name": "@imperium/admin",
  "version": "1.0.0",
  "description": "DALLI Admin Panel - Premium E-commerce Administration",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "build:ssr": "SSR=true vite build",
    "preview": "vite preview --host",
    "lint": "eslint js --ext .js,.ts --fix",
    "lint:check": "eslint js --ext .js,.ts",
    "format": "prettier --write \"**/*.{js,ts,json,css,scss,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,css,scss,html,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "postinstall": "patch-package",
    "clean": "rm -rf dist node_modules/.vite coverage .turbo",
    "docker:build": "docker build -t imperium-admin:latest .",
    "docker:run": "docker run -p 8080:80 imperium-admin:latest",
    "deploy:staging": "npm run build && vercel deploy --prod=false",
    "deploy:prod": "npm run build && vercel deploy --prod"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "chartjs-adapter-date-fns": "^3.0.0",
    "croner": "^9.0.0",
    "date-fns": "^3.6.0",
    "idb": "^8.0.0",
    "recharts": "^2.12.7",
    "workbox-window": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/recharts": "^1.8.29",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "cssnano": "^7.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^48.0.0",
    "eslint-plugin-perfectionist": "^2.11.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.39",
    "postcss-preset-env": "^10.6.1",
    "prettier": "^3.3.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.77.0",
    "terser": "^5.31.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-compression2": "^1.1.0",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.0",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not IE 11"
  ],
  "sideEffects": false,
  "keywords": [
    "admin",
    "dashboard",
    "ecommerce",
    "imperium",
    "dalli"
  ],
  "author": "DALLI Team",
  "license": "UNLICENSED",
  "private": true
}
