# Imperium Admin - Environment Configuration
# Copy to .env.local for local development, never commit this file

# =============================================================================
# APPLICATION
# =============================================================================
VITE_APP_NAME=DALLI Admin
VITE_APP_VERSION=1.0.0
VITE_BASE_URL=/admin/
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8001

# =============================================================================
# AUTHENTICATION
# =============================================================================
VITE_AUTH_PROVIDER=jwt
VITE_JWT_ISSUER=https://auth.dalli.rs
VITE_JWT_AUDIENCE=admin
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/admin/callback

# =============================================================================
# FEATURE FLAGS
# =============================================================================
VITE_ENABLE_PWA=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=
VITE_HOTJAR_ID=
VITE_INTERCOM_APP_ID=
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=

# =============================================================================
# STORAGE
# =============================================================================
VITE_STORAGE_PREFIX=imperium_
VITE_CACHE_TTL=300
VITE_OFFLINE_QUEUE_LIMIT=1000

# =============================================================================
# DEVELOPMENT
# =============================================================================
VITE_SSL=false
VITE_MOCK_API=false
VITE_LOG_LEVEL=debug
VITE_DEV_TOOLS=true