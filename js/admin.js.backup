// Status Update Functions
function updateOrderStatus(orderNumber, status) {
    const orders = getOrders();
    const order = orders.find(o => o.orderNumber === orderNumber);
    if (!order) return;
    order.status = status;
    saveOrders(orders);
    renderOrders();
    showToast(`Status porudžbine ${orderNumber} promenjen na ${getStatusLabel(status, 'orders')}`);
    
    // Trigger email based on order status
    triggerOrderStatusEmail(orderNumber, status);
}

/**
 * Trigger appropriate email based on order status change
 * @param {string} orderNumber - Order number
 * @param {string} newStatus - New order status
 */
function triggerOrderStatusEmail(orderNumber, newStatus, options = {}) {
    const orders = getOrders();
    const order = orders.find(o => o.orderNumber === orderNumber);
    if (!order) return;
    
    const customer = order.customer || {};
    const customerEmail = customer.email || '';
    const customerName = customer.firstName ? `${customer.firstName} ${customer.lastName || ''}`.trim() : '';
    const customerId = customer.id || '';
    
    // Get order items summary
    const itemsSummary = order.items ? order.items.map(i => `${i.name} (${i.quantity}x)`).join(', ') : 'Nema artikala';
    
    // Get total amount
    const totalAmount = order.total || 0;
    
    // Get order items details for template
    const itemsDetails = order.items ? order.items.map(i => ({
        name: i.name,
        quantity: i.quantity,
        price: i.price,
        image: i.image || '',
        sku: i.sku || ''
    })) : [];
    
    // Map status to email template and subject
    const emailConfig = {
        confirmed: {
            template: 'order-confirmation',
            subject: 'Potvrda vaše porudžbine - DALLI',
            type: 'confirmation'
        },
        shipped: {
            template: 'order-shipped',
            subject: 'Porudžbina šalje - Informacija o pratilici',
            type: 'shipping'
        },
        delivered: {
            template: 'order-delivered',
            subject: 'Čestitamo! Porudžbina isporučena',
            type: 'delivery'
        },
        cancelled: {
            template: 'order-confirmation',
            subject: 'Porudžbina otkazana - DALLI',
            type: 'cancellation'
        }
    };
    
    const config = emailConfig[newStatus];
    if (!config) {
        console.warn(`No email config for status: ${newStatus}`);
        return;
    }
    
    // Prepare comprehensive template data
    const templateData = {
        // Order basics
        ordernumber: order.orderNumber,
        orderdate: order.timestamp ? new Date(order.timestamp).toLocaleDateString('sr-RS', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '',
        paymentmethod: order.payment || 'N/A',
        totalamount: totalAmount,
        currency: order.currency || 'RSD',
        
        // Items
        items: itemsDetails,
        itemscount: order.items ? order.items.length : 0,
        itemsummary: itemsSummary,
        itempricetotal: order.items ? order.items.reduce((sum, i) => sum + (i.price * i.quantity), 0) : 0,
        
        // Status-specific data
        type: config.type,
        status: newStatus,
        
        // Shipped-specific
        trackingnumber: order.trackingNumber || '',
        carrier: order.carrier || '',
        estimateddelivery: order.estimatedDelivery || '',
        deliveryindays: order.deliveryInDays || '',
        shippingmethod: order.shippingMethod || '',
        
        // Delivered-specific
        deliverydate: newStatus === 'delivered' ? new Date().toLocaleDateString('sr-RS', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '',
        deliveryconfirmed: newStatus === 'delivered',
        
        // Customer data
        customername: customerName || '',
        customeremail: customerEmail || '',
        customerid: customerId,
        
        // Order URL and links
        orderdetailsurl: `${window.location.origin}/porudzbina.html?order=${order.orderNumber}`,
        customergalleryurl: '${window.location.origin}/korisnicki-racun',
        loginurl: 'https://dalli.rs/login',
        
        // Feedback and offers
        feedbackurl: '#',
        feedbackurl2: '#',
        welcomeoffer: 'WELCOME10',
        offerexpires: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toLocaleDateString('sr-RS')
    };
    
    // Send email via available method
    const sendMethod = options && options.sendMethod ? options.sendMethod : (window.emailjs ? 'emailjs' : (window.fetch ? 'fetch' : 'console'));
    
    switch (sendMethod) {
        case 'emailjs':
            if (typeof emailjs !== 'undefined') {
                sendEmailViaEmailJS(templateData, config);
            } else {
                console.log('EmailJS not initialized, falling back to console');
                sendEmailViaConsole(templateData, config);
            }
            break;
            
        case 'fetch':
            sendEmailViaFetch(templateData, config);
            break;
            
        case 'console':
        default:
            sendEmailViaConsole(templateData, config);
            break;
    }
}

/**
 * Send email via EmailJS
 * @param {object} templateData - Template data
 * @param {object} config - Email config
 */
function sendEmailViaEmailJS(templateData, config) {
    if (typeof emailjs === 'undefined') {
        console.error('EmailJS library not loaded');
        sendEmailViaConsole(templateData, config);
        return;
    }
    
    emailjs.send(
        'service_dalli',
        'template_dalli',
        {
            to_email: templateData.customeremail,
            to_name: templateData.customername,
            order_number: templateData.ordernumber,
            order_date: templateData.orderdate,
            status: templateData.status,
            items: templateData.items,
            total: templateData.totalamount,
            subject: config.subject
        }
    ).then((response) => {
        console.log('Email sent via EmailJS:', response.status);
        showToast(`Email successfully sent for order ${templateData.ordernumber}`, 'success');
    }).catch((error) => {
        console.error('EmailJS error:', error);
        showToast(`Failed to send email for order ${templateData.ordernumber}`, 'error');
        sendEmailViaConsole(templateData, config);
    });
}

/**
 * Send email via Fetch API to Netlify Function
 * @param {object} templateData - Template data
 * @param {object} config - Email config
 */
function sendEmailViaFetch(templateData, config) {
    fetch('/.netlify/functions/send-email', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        },
        body: JSON.stringify({
            template: config.template,
            to: templateData.customeremail,
            subject: config.subject,
            data: {
                ordernumber: templateData.ordernumber,
                orderdate: templateData.orderdate,
                paymentmethod: templateData.paymentmethod,
                totalamount: templateData.totalamount,
                items: templateData.items,
                itemsummary: templateData.itemsummary,
                trackingnumber: templateData.trackingnumber,
                carrier: templateData.carrier,
                shipstatus: templateData.status
            }
        })
    })
    .then(async response => {
        const data = await response.json();
        if (response.ok) {
            console.log('Email sent via Netlify Function:', data);
            showToast(`Email successfully sent for order ${templateData.ordernumber}`, 'success');
        } else {
            console.error('Netlify Function error:', data);
            showToast(`Failed to send email: ${data.error || 'Unknown error'}`, 'error');
            sendEmailViaConsole(templateData, config);
        }
    })
    .catch((error) => {
        console.error('Fetch error:', error);
        showToast(`Network error sending email`, 'error');
        sendEmailViaConsole(templateData, config);
    });
}

/**
 * Send email via console logging (fallback)
 * @param {object} templateData - Template data
 * @param {object} config - Email config
 */
function sendEmailViaConsole(templateData, config) {
    console.log('=== TRANSACTIONAL EMAIL ===');
    console.log('Template:', config.template);
    console.log('Subject:', config.subject);
    console.log('To:', templateData.customeremail);
    console.log('Customer Name:', templateData.customername);
    console.log('Order Number:', templateData.ordernumber);
    console.log('Order Status:', templateData.status);
    console.log('Items Count:', templateData.itemscount);
    console.log('Total Amount:', templateData.totalamount, templateData.currency);
    console.log('Tracking Number:', templateData.trackingnumber);
    console.log('=========================');
    showToast(`Podaci za email porudžbine ${templateData.ordernumber} su pripremljeni}`, 'info');
}
function updateComplaintStatus(complaintId, status) {
    const complaints = getComplaints();
    const complaint = complaints.find(c => c.id === complaintId);
    if (!complaint) return;
    complaint.status = status;
    saveComplaints(complaints);
    renderComplaints();
    showToast(`Status žalbe ${complaintId} promenjen na ${getStatusLabel(status, 'complaints')}`);
}

function updateAdStatus(adId, status) {
    const ads = getAds();
    const ad = ads.find(a => a.id === adId);
    if (!ad) return;
    ad.status = status;
    saveAds(ads);
    renderAds();
    showToast(`Status reklame ${adId} promenjen na ${getStatusLabel(status, 'ads')}`);
}

function deleteOrder(orderNumber) {
    if (!confirm('Obriši porudžbinu? Ova akcija je nepovratna.')) return;
    const orders = getOrders();
    const order = orders.find(o => o.orderNumber === orderNumber);
    if (order) moveToTrash('order', order, 'admin');
    saveOrders(orders.filter(o => o.orderNumber !== orderNumber));
    renderOrders();
    showToast('Porudžbina obrisana.');
}

// Accounting
function renderAccounting() {
    const month = document.getElementById('accountingMonth')?.value || new Date().toISOString().slice(0, 7);
    const orders = getOrders().filter(o => o.timestamp.startsWith(month));
    const complaints = getComplaints().filter(c => c.timestamp.startsWith(month));

    const revenue = orders.reduce((sum, o) => sum + (o.total || 0), 0);
    const returns = complaints.filter(c => c.type === 'return' && c.status === 'resolved');
    const returnsValue = returns.reduce((sum, c) => {
        const order = getOrders().find(o => o.orderNumber === c.orderNumber);
        return sum + (order?.total || 0);
    }, 0);
    const netRevenue = revenue - returnsValue;

    const tbody = document.getElementById('accountingTableBody');
    const emptyEl = document.getElementById('accountingEmpty');
    if (!tbody) return;

    if (orders.length === 0) { tbody.innerHTML = ''; if (emptyEl) emptyEl.classList.remove('hidden'); updateAccountingSummary(0, 0, 0, 0); return; }
    if (emptyEl) emptyEl.classList.add('hidden');

    tbody.innerHTML = orders.map(function(order) {
        var firstItem = order.items && order.items[0];
        var productImg = firstItem ? '<img src="' + firstItem.image + '" alt="' + firstItem.name + '" style="width:32px;height:32px;object-fit:cover;border-radius:4px;">' : '';
        var productName = firstItem ? firstItem.name : 'Nema proizvoda';
        var otherItemsCount = (order.items && order.items.length > 1) ? ' +' + (order.items.length - 1) + ' jos' : '';
        var itemsHtml = order.items ? order.items.map(function(i) {
            return i.name + ' (' + i.quantity + 'x' + formatPrice(i.price) + ')';
        }).join(', ') : '';
        var totalQty = order.items ? order.items.reduce(function(s, i) { return s + i.quantity; }, 0) : 0;
        var statusLabel = getStatusLabel(order.status, 'orders');
        var paymentIcon = order.payment === 'cod' ? '&#x1F4B0;' : '&#x1F3E6;';
        
        return '<tr onclick="viewOrder(\'' + order.orderNumber + '\')" style="cursor:pointer;">' +
            '<td data-label="Proizvod"><div style="display:flex;align-items:center;gap:8px;">' + productImg +
            '<div><strong>' + productName + '</strong>' +
            (otherItemsCount ? '<br><small style="color:var(--text-light);">' + otherItemsCount + '</small>' : '') +
            '</div></div></td>' +
            '<td data-label="Broj">' + order.orderNumber + '</td>' +
            '<td data-label="Datum">' + formatDate(order.timestamp) + '</td>' +
            '<td data-label="Kupac">' + (order.customer ? order.customer.firstName + ' ' + order.customer.lastName : '') + '</td>' +
            '<td data-label="Artikli">' + itemsHtml + '</td>' +
            '<td data-label="Komada">' + totalQty + '</td>' +
            '<td data-label="Iznos">' + formatPrice(order.total) + '</td>' +
            '<td data-label="Status"><span class="status-badge status-' + order.status + '">' + statusLabel + '</span></td>' +
            '<td data-label="Plaćanje">' + paymentIcon + '</td>' +
            '</tr>';
    }).join('');

    updateAccountingSummary(revenue, returnsValue, returns.length, netRevenue);
}

function updateAccountingSummary(revenue, returnsValue, returnsCount, net) {
    const els = {
        revenue: document.getElementById('accRevenue'),
        returns: document.getElementById('accReturns'),
        returnsCount: document.getElementById('accReturnsCount'),
        net: document.getElementById('accNet')
    };
    if (els.revenue) els.revenue.textContent = formatPrice(revenue);
    if (els.returns) els.returns.textContent = formatPrice(returnsValue);
    if (els.returnsCount) els.returnsCount.textContent = returnsCount;
    if (els.net) els.net.textContent = formatPrice(net);
}

// Analytics
function renderAnalytics() {
    const period = document.getElementById('analyticsPeriod')?.value || '30';
    const cutoff = new Date(); cutoff.setDate(cutoff.getDate() - parseInt(period));
    const analytics = getAnalytics().filter(a => new Date(a.date) >= cutoff);
    const orders = getOrders().filter(o => new Date(o.timestamp) >= cutoff);
    const complaints = getComplaints().filter(c => new Date(c.timestamp) >= cutoff);

    const totalViews = analytics.reduce((s, a) => s + (a.pageViews || 0), 0);
    const totalVisitors = new Set(analytics.flatMap(a => a.uniqueVisitors || [])).size;
    const totalSessions = new Set(analytics.flatMap(a => a.sessions || [])).size;

    const productSales = {};
    orders.forEach(o => o.items?.forEach(i => { productSales[i.id] = (productSales[i.id] || 0) + i.quantity; }));
    const topProducts = Object.entries(productSales).sort((a, b) => b[1] - a[1]).slice(0, 5);

    const productReturns = {};
    complaints.filter(c => c.type === 'return').forEach(c => {
        const order = getOrders().find(o => o.orderNumber === c.orderNumber);
        order?.items?.forEach(i => { productReturns[i.id] = (productReturns[i.id] || 0) + i.quantity; });
    });
    const topReturns = Object.entries(productReturns).sort((a, b) => b[1] - a[1]).slice(0, 5);

    const satisfied = orders.filter(o => o.status === 'delivered').length;
    const totalCompleted = orders.filter(o => ['delivered', 'cancelled'].includes(o.status)).length;
    const satisfactionRate = totalCompleted > 0 ? Math.round((satisfied / totalCompleted) * 100) : 100;

    var viewsEl = document.getElementById('analyticsTotalViews');
    if (viewsEl) viewsEl.textContent = totalViews;
    var visitorsEl = document.getElementById('analyticsTotalVisitors');
    if (visitorsEl) visitorsEl.textContent = totalVisitors;
    var sessionsEl = document.getElementById('analyticsTotalSessions');
    if (sessionsEl) sessionsEl.textContent = totalSessions;
    var convEl = document.getElementById('analyticsConversion');
    if (convEl) convEl.textContent = totalVisitors > 0 ? ((orders.length / totalVisitors) * 100).toFixed(1) + '%' : '0%';
    var satEl = document.getElementById('analyticsSatisfaction');
    if (satEl) satEl.textContent = satisfactionRate + '%';

    const topProductsEl = document.getElementById('topProductsList');
    if (topProductsEl) topProductsEl.innerHTML = topProducts.map(([id, qty]) => `<tr><td>${PRODUCTS.find(p => p.id === parseInt(id))?.name || id}</td><td>${qty}</td></tr>`).join('') || '<tr><td colspan="2">Nema prodaje</td></tr>';

    const topReturnsEl = document.getElementById('topReturnsList');
    if (topReturnsEl) topReturnsEl.innerHTML = topReturns.map(([id, qty]) => `<tr><td>${PRODUCTS.find(p => p.id === parseInt(id))?.name || id}</td><td>${qty}</td></tr>`).join('') || '<tr><td colspan="2">Nema povraćaja</td></tr>';

    renderSatisfactionGauge(satisfactionRate);
    renderTrafficChart(analytics);
    renderDeviceChart(analytics);
}

function renderSatisfactionGauge(rate) {
    const canvas = document.getElementById('satisfactionGauge');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width = 200, h = canvas.height = 200;
    const centerX = w / 2, centerY = h / 2, radius = 80;
    const startAngle = -Math.PI / 2, endAngle = startAngle + (rate / 100) * 2 * Math.PI;

    ctx.clearRect(0, 0, w, h);
    ctx.beginPath(); ctx.arc(centerX, centerY, radius, 0, 2 * Math.PI); ctx.strokeStyle = '#e0e0e0'; ctx.lineWidth = 15; ctx.stroke();
    ctx.beginPath(); ctx.arc(centerX, centerY, radius, startAngle, endAngle); ctx.strokeStyle = rate >= 80 ? '#27ae60' : rate >= 60 ? '#f39c12' : '#e74c3c'; ctx.lineWidth = 15; ctx.lineCap = 'round'; ctx.stroke();
    ctx.font = 'bold 36px sans-serif'; ctx.fillStyle = '#2c3e50'; ctx.textAlign = 'center'; ctx.fillText(rate + '%', centerX, centerY + 12);
    ctx.font = '14px sans-serif'; ctx.fillStyle = '#7f8c8d'; ctx.fillText('Zadovoljstvo', centerX, centerY + 40);
}

function renderTrafficChart(analytics) {
    const canvas = document.getElementById('trafficChart');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width = canvas.parentElement.clientWidth, h = canvas.height = 200;
    const days = analytics.slice(-30);
    const maxViews = Math.max(...days.map(d => d.pageViews || 0), 1);
    const stepX = w / (days.length + 1);

    ctx.clearRect(0, 0, w, h);
    ctx.beginPath();
    days.forEach((d, i) => {
        const x = (i + 1) * stepX, y = h - (d.pageViews / maxViews) * (h - 40) - 20;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.strokeStyle = '#3498db'; ctx.lineWidth = 2; ctx.stroke();
    ctx.fillStyle = '#3498db'; days.forEach((d, i) => { const x = (i + 1) * stepX, y = h - (d.pageViews / maxViews) * (h - 40) - 20; ctx.beginPath(); ctx.arc(x, y, 3, 0, 2 * Math.PI); ctx.fill(); });
}

function renderDeviceChart(analytics) {
    const canvas = document.getElementById('deviceChart');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width = canvas.parentElement.clientWidth, h = canvas.height = 200;
    const devices = { mobile: 0, desktop: 0 };
    analytics.forEach(a => { Object.entries(a.devices || {}).forEach(([k, v]) => { devices[k] = (devices[k] || 0) + v; }); });
    const total = devices.mobile + devices.desktop || 1;
    const colors = { mobile: '#e74c3c', desktop: '#3498db' };
    let startAngle = -Math.PI / 2;
    Object.entries(devices).forEach(([k, v]) => {
        const sliceAngle = (v / total) * 2 * Math.PI;
        ctx.beginPath(); ctx.moveTo(w/2, h/2); ctx.arc(w/2, h/2, 80, startAngle, startAngle + sliceAngle); ctx.closePath();
        ctx.fillStyle = colors[k]; ctx.fill();
        startAngle += sliceAngle;
    });
    ctx.font = '14px sans-serif'; ctx.fillStyle = '#2c3e50'; ctx.textAlign = 'center';
    ctx.fillText(`Mobilni: ${Math.round(devices.mobile/total*100)}%`, w/2, h/2 - 10);
    ctx.fillText(`Desktop: ${Math.round(devices.desktop/total*100)}%`, w/2, h/2 + 20);
}

// Trash
function renderTrash() {
    const trash = getTrash().filter(t => new Date(t.expiresAt) > new Date());
    const tbody = document.getElementById('trashTableBody');
    const emptyEl = document.getElementById('trashEmpty');
    const role = localStorage.getItem('dalli_admin_role');
    const isAbsolute = role === ROLES.vlasnik;
    if (!tbody) return;

    if (trash.length === 0) { tbody.innerHTML = ''; if (emptyEl) emptyEl.classList.remove('hidden'); return; }
    if (emptyEl) emptyEl.classList.add('hidden');

    tbody.innerHTML = trash.map(item => `
        <tr>
            <td>${item.id}</td>
            <td>${item.originalType === 'order' ? '📦 Narudžbina' : item.originalType === 'complaint' ? '📋 Žalba' : '📢 Reklama'}</td>
            <td>${item.originalId}</td>
            <td>${item.deletedBy}</td>
            <td>${formatDate(item.deletedAt)}</td>
            <td>${Math.ceil((new Date(item.expiresAt) - new Date()) / (1000*60*60*24))} dana</td>
            <td>
                <div class="admin-actions">
                    <button class="btn-action view" onclick="restoreFromTrashUI('${item.id}')">Vrati</button>
                    ${isAbsolute ? `<button class="btn-action delete" onclick="purgeFromTrashUI('${item.id}')">Obriši zauvijek</button>` : ''}
                </div>
            </td>
        </tr>
    `).join('');
}

function restoreFromTrashUI(trashId) { if (restoreFromTrash(trashId)) { renderTrash(); renderAllTabs(localStorage.getItem('dalli_admin_role')); showToast('Vraćeno iz korpe za otpad!'); } }
function purgeFromTrashUI(trashId) { if (confirm('Obriši zauvijek? Ne može se vratiti!')) { purgeFromTrash(trashId); renderTrash(); showToast('Zauvek obrisano.'); } }

// Customers
function renderCustomers() {
    const customers = getCustomers();
    const tbody = document.getElementById('customersTableBody');
    const emptyEl = document.getElementById('customersEmpty');
    if (!tbody) return;

    if (customers.length === 0) { tbody.innerHTML = ''; if (emptyEl) emptyEl.classList.remove('hidden'); return; }
    if (emptyEl) emptyEl.classList.add('hidden');

    tbody.innerHTML = customers.map(c => `
        <tr onclick="viewCustomer('${c.id}')" style="cursor:pointer;">
            <td>${c.id}</td>
            <td>${c.firstName} ${c.lastName}</td>
            <td>${c.email}</td>
            <td>${c.phone}</td>
            <td>${c.totalOrders}</td>
            <td>${formatPrice(c.totalSpent)}</td>
            <td>${c.marketingConsent ? '✅ Da' : '❌ Ne'}</td>
            <td>${formatDate(c.lastOrderAt)}</td>
        </tr>
    `).join('');
}

function viewCustomer(customerId) {
    const customers = getCustomers();
    const c = customers.find(x => x.id === customerId);
    if (!c) return;
    alert(`Kupac: ${c.firstName} ${c.lastName}\nEmail: ${c.email}\nTelefon: ${c.phone}\nUkupno narudžbina: ${c.totalOrders}\nUkupno potrošeno: ${formatPrice(c.totalSpent)}\nMarketing: ${c.marketingConsent ? 'Da' : 'Ne'}`);
}

// CMS Access
function checkCmsAccess() {
    const badge = document.getElementById('cmsStatusBadge');
    const permInfo = document.getElementById('cmsPermissionsInfo');
    const permList = document.getElementById('userPermissionsList');
    const role = localStorage.getItem('dalli_admin_role');
    
    if (!badge) return;
    
    badge.textContent = 'Provera...';
    badge.style.background = '#fef9e7';
    badge.style.color = '#f39c12';
    
    setTimeout(() => {
        const canAccess = role === ROLES.vlasnik || role === ROLES.ADMIN;
        
        if (canAccess) {
            badge.textContent = '✅ Dozvoljen pristup';
            badge.style.background = '#e8f8f5';
            badge.style.color = '#27ae60';
            if (permInfo) permInfo.style.display = 'block';
            if (permList) permList.innerHTML = getEmployeePermissionsById('current').map(p => `<li>${p}</li>`).join('');
        } else {
            badge.textContent = '❌ Nemate dozvolu';
            badge.style.background = '#fadbd8';
            badge.style.color = '#e74c3c';
            if (permInfo) permInfo.style.display = 'none';
        }
    }, 500);
}

function getEmployeePermissionsById(empId) {
    const role = localStorage.getItem('dalli_admin_role');
    const perms = {
        [ROLES.vlasnik]: ['Sve dozvole (vlasnik)', 'Upravljanje proizvodima', 'Upravljanje zaposlenima', 'Knjigovodstvo i analitika', 'Hard delete', 'Podešavanja'],
        [ROLES.ADMIN]: ['Upravljanje proizvodima', 'Upravljanje narudžbinama', 'Žalbe i reklame', 'Knjigovodstvo i analitika', 'Podešavanja'],
        [ROLES.ACCOUNTANT]: ['Pregled narudžbina', 'Knjigovodstvo i analitika', 'Pregled kupaca'],
        [ROLES.EMPLOYEE]: ['Pregled narudžbina', 'Žalbe i reklame', 'Korpa za otpad'],
        [ROLES.READ_ONLY]: ['Pregled narudžbina', 'Žalbe i reklame']
    };
    return perms[role] || ['Bez dozvola'];
}

function openProductCMS() {
    window.open('admin/index.html', '_blank', 'noopener,noreferrer');
}

// Settings
function setupSettings() {
    // Change Password
    const passForm = document.getElementById('changePasswordForm');
    if (passForm) {
        passForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const current = document.getElementById('currentPassword').value;
            const newPass = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            
            const stored = localStorage.getItem(ADMIN_PASSWORD_KEY);
            if (current !== stored) { showToast('Trenutna lozinka nije tačna!', 'error'); return; }
            if (newPass !== confirm) { showToast('Lozinke se ne podudaraju!', 'error'); return; }
            if (newPass.length < 6) { showToast('Lozinka mora imati najmanje 6 karaktera!', 'error'); return; }
            
            localStorage.setItem(ADMIN_PASSWORD_KEY, newPass);
            showToast('Lozinka uspešno promenjena!');
            passForm.reset();
        });
    }
    
    // Markets & Regions
    initMarketsRegionsSettings();
    
    // Clear All Data
    const clearBtn = document.getElementById('clearAllData');
    if (clearBtn) {
        clearBtn.addEventListener('click', () => {
            if (!confirm('OVO BRIŠE SVE PODATKE (narudžbine, žalbe, reklame, kupce, analitiku). Siguran?')) return;
            if (!confirm('Poslednje upozorenje - ova akcija je NEPOVRATNA!')) return;
            
            localStorage.removeItem('dalli_orders');
            localStorage.removeItem('dalli_complaints');
            localStorage.removeItem('dalli_advertising');
            localStorage.removeItem('dalli_customers');
            localStorage.removeItem('dalli_analytics');
            localStorage.removeItem('dalli_trash');
            localStorage.removeItem('dalli_accounting');
            
            renderAllTabs(localStorage.getItem('dalli_admin_role'));
            showToast('Svi podaci obrisani!');
        });
    }
}

// Markets & Regions Settings
function initMarketsRegionsSettings() {
    const marketsConfig = window.DALLI_I18N?.getMarketsConfig?.() || {};
    const countries = Object.keys(marketsConfig || {});
    
    // Render markets & regions panel
    const panel = document.getElementById('marketsRegionsPanel');
    if (!panel) return;
    
    panel.innerHTML = `
        <div class="settings-section">
            <h3>🌍 Markets & Regions</h3>
            <p>Konfiguracija zemalja, regija i valuta</p>
        </div>
        <div class="settings-form">
            <div class="form-row">
                <div class="form-group">
                    <label>Dodeljena zemlje</label>
                    <select id="marketsCountrySelect" class="nc-field-input" multiple style="height:200px;">
                        ${countries.map(country => `<option value="${country}">${country}</option>`).join('')}
                    </select>
                </div>
                <div class="form-group">
                    <label>Regije za izabranu zemlju</label>
                    <select id="marketsRegionSelect" class="nc-field-input" multiple style="height:200px;">
                        ${(marketsConfig['RS'] || {}).regions ? Object.keys((marketsConfig['RS'] || {}).regions).map(region => `<option value="${region}">${region}</option>`).join('') : ''}
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Dodajiju novu zemlju</label>
                    <input type="text" id="newCountryInput" class="nc-field-input" placeholder="Naziv zemlje">
                </div>
                <div class="form-group">
                    <label>Dodajiju regiju</label>
                    <input type="text" id="newRegionInput" class="nc-field-input" placeholder="Naziv regije">
                </div>
                <button class="btn btn-primary" onclick="addMarketCountry()">Dodaj</button>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Dodeljivanje valute</label>
                    <select id="marketCurrencySelect" class="nc-field-input">
                        <option value="RSD">SRD (Srbija)</option>
                        <option value="EUR">EUR (Evropa)</option>
                        <option value="USD">USD (Sjedinjene Američke Države)</option>
                        <option value="GBP">GBP (Velika Britanija)</option>
                    </select>
                </div>
                <button class="btn btn-primary" onclick="assignMarketCurrency()">Dodeli valutu</button>
            </div>
        </div>
    `;
    
    // Country change handler
    const countrySelect = document.getElementById('marketsCountrySelect');
    const regionSelect = document.getElementById('marketsRegionSelect');
    
    if (countrySelect) {
        countrySelect.addEventListener('change', () => {
            const selectedCountries = countrySelect.value;
            const regions = [];
            selectedCountries.forEach(country => {
                const countryConfig = marketsConfig[country] || {};
                if (countryConfig.regions) {
                    regions.push(...Object.keys(countryConfig.regions));
                }
            });
            regionSelect.innerHTML = regions.map(region => `<option value="${region}">${region}`).join('');
        });
    }
    
    // Initial load of regions for Serbia
    if (countrySelect && regionSelect) {
        countrySelect.value = ['RS'];
        if (marketsConfig['RS'] && marketsConfig['RS'].regions) {
            regionSelect.innerHTML = Object.keys(marketsConfig['RS'].regions).map(region => `<option value="${region}">${region}</option>`).join('');
        }
    }
    
    function addMarketCountry() {
        const countryInput = document.getElementById('newCountryInput');
        const regionInput = document.getElementById('newRegionInput');
        const country = countryInput?.value?.trim();
        const region = regionInput?.value?.trim();
        
        if (!country) { showToast('Unesite naziv zemlje!', 'error'); return; }
        
        // Initialize country config if not exists
        if (!marketsConfig[country]) {
            marketsConfig[country] = { regions: {} };
        }
        
        // Add region if specified
        if (region) {
            marketsConfig[country].regions[region] = {
                taxRate: 0.20,
                shipping: 'standard',
                active: true
            };
        }
        
        // Save config
        saveMarketsConfig(marketsConfig);
        
        // Re-render panel
        initMarketsRegionsSettings();
        showToast(`Zemlja ${country} dodata!`);
        
        countryInput.value = '';
        regionInput.value = '';
    }
    
    function assignMarketCurrency() {
        const currencySelect = document.getElementById('marketCurrencySelect');
        if (!currencySelect) return;
        
        const currency = currencySelect.value;
        const selectedCountries = document.getElementById('marketsCountrySelect')?.value || [];
        
        selectedCountries.forEach(country => {
            if (!marketsConfig[country]) marketsConfig[country] = {};
            marketsConfig[country].currency = currency;
        });
        
        saveMarketsConfig(marketsConfig);
        showToast(`Valuta ${currency} dodeljena izabranim zemljama!`);
    }
    
    function saveMarketsConfig(config) {
        localStorage.setItem('dalli_markets_config', JSON.stringify(config));
        // Also update i18n config
        if (window.DALLI_I18N && window.DALLI_I18N.saveMarketsConfig) {
            window.DALLI_I18N.saveMarketsConfig(config);
        }
    }
}

// Logout
function setupLogout() {
    const logoutBtn = document.getElementById('adminLogout');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', () => {
            localStorage.removeItem('dalli_admin_auth');
            localStorage.removeItem('dalli_admin_role');
            localStorage.removeItem('dalli_admin_employee_id');
            localStorage.removeItem('dalli_admin_employee_name');
            window.location.href = 'admin-login.html';
        });
    }
}

// Modals
function setupModals() {
    document.querySelectorAll('.modal-close').forEach(btn => btn.addEventListener('click', () => btn.closest('.modal').classList.add('hidden')));
    document.querySelectorAll('.modal').forEach(m => m.addEventListener('click', e => { if (e.target === m) m.classList.add('hidden'); }));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.modal:not(.hidden)').forEach(m => m.classList.add('hidden')); });
}

// Filters
function setupFilters() {
    const orderStatusFilter = document.getElementById('orderStatusFilter');
    const orderSearch = document.getElementById('orderSearch');
    if (orderStatusFilter) orderStatusFilter.addEventListener('change', renderOrders);
    if (orderSearch) orderSearch.addEventListener('input', debounce(renderOrders, 300));
    
    const complaintStatusFilter = document.getElementById('complaintStatusFilter');
    const complaintSearch = document.getElementById('complaintSearch');
    if (complaintStatusFilter) complaintStatusFilter.addEventListener('change', renderComplaints);
    if (complaintSearch) complaintSearch.addEventListener('input', debounce(renderComplaints, 300));
    
    const adStatusFilter = document.getElementById('adStatusFilter');
    const adSearch = document.getElementById('adSearch');
    if (adStatusFilter) adStatusFilter.addEventListener('change', renderAds);
    if (adSearch) adSearch.addEventListener('input', debounce(renderAds, 300));
}

// Utility Functions
function getTrash() { const s = localStorage.getItem('dalli_trash'); return s ? JSON.parse(s) : []; }
function saveTrash(trash) { localStorage.setItem('dalli_trash', JSON.stringify(trash)); }
function restoreFromTrash(trashId) { const trash = getTrash(); const item = trash.find(t => t.id === trashId); if (!item) return false; if (item.originalType === 'order') saveOrders([...getOrders(), item.data]); else if (item.originalType === 'complaint') saveComplaints([...getComplaints(), item.data]); else if (item.originalType === 'advertising') saveAds([...getAds(), item.data]); saveTrash(trash.filter(t => t.id !== trashId)); return true; }
function purgeFromTrash(trashId) { saveTrash(getTrash().filter(t => t.id !== trashId)); }
function getAccounting() { const s = localStorage.getItem('dalli_accounting'); return s ? JSON.parse(s) : []; }
function saveAccounting(a) { localStorage.setItem('dalli_accounting', JSON.stringify(a)); }
function getAnalytics() { const s = localStorage.getItem('dalli_analytics'); return s ? JSON.parse(s) : []; }
function saveAnalytics(a) { localStorage.setItem('dalli_analytics', JSON.stringify(a)); }
function getCustomers() { const s = localStorage.getItem('dalli_customers'); return s ? JSON.parse(s) : []; }
function saveCustomers(c) { localStorage.setItem('dalli_customers', JSON.stringify(c)); }
function getEmployees() { const s = localStorage.getItem('dalli_employees'); if (s) return JSON.parse(s); const def = [{ id: 'EMP-001', email: 'harissacirovic', name: 'Hariss Acircovic (Vlasnik)', password: 'lenovo123', role: ROLES.vlasnik, permissions: {}, status: 'active', hardDeleteAllowed: true, createdAt: new Date().toISOString(), createdBy: 'system', lastLogin: null }, { id: 'EMP-002', email: 'dalilapepic', name: 'Dalila Pepic (Admin)', password: 'poslodavac123', role: ROLES.vlasnik, permissions: {}, status: 'active', hardDeleteAllowed: true, createdAt: new Date().toISOString(), createdBy: 'system', lastLogin: null }]; localStorage.setItem('dalli_employees', JSON.stringify(def)); return def; }
function saveEmployees(e) { localStorage.setItem('dalli_employees', JSON.stringify(e)); }
function getOrders() { const s = localStorage.getItem('dalli_orders'); return s ? JSON.parse(s) : []; }
function saveOrders(o) { localStorage.setItem('dalli_orders', JSON.stringify(o)); }
function getComplaints() { const s = localStorage.getItem('dalli_complaints'); return s ? JSON.parse(s) : []; }
function saveComplaints(c) { localStorage.setItem('dalli_complaints', JSON.stringify(c)); }
function getAds() { const s = localStorage.getItem('dalli_advertising'); return s ? JSON.parse(s) : []; }
function saveAds(a) { localStorage.setItem('dalli_advertising', JSON.stringify(a)); }

function formatDate(d) { return new Date(d).toLocaleDateString('sr-RS', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }); }
function formatPrice(p) { return new Intl.NumberFormat('sr-RS').format(p) + ' RSD'; }
function getRoleLabel(r) { const l = { admin: 'Apsolutni Administrator', admin: 'Administrator', accountant: 'Knjigovodja', employee: 'Zaposleni', read_only: 'Samo čitanje' }; return l[r] || r; }
function getStatusLabel(s, t) { const L = { orders: { new: 'Nova', confirmed: 'Potvrđena', shipped: 'Poslata', delivered: 'Isporučena', cancelled: 'Otkazana' }, complaints: { open: 'Otvorena', in_progress: 'U Obradi', resolved: 'Rešena', rejected: 'Odbijena' }, ads: { pending: 'Na Čekanju', approved: 'Odobrena', rejected: 'Odbijena' } }; return L[t]?.[s] || s; }

function debounce(fn, d) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), d); }; }

// Initialize on DOM ready
document.addEventListener('DOMContentLoaded', initAdmin);
