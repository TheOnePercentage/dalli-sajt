// Global functions (available immediately)
window.toggleAdminMenu = function(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('adminDropdownMenu');
    const btn = document.getElementById('adminDropdownBtn');
    if (menu && btn) {
        const isOpen = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', isOpen);
    }
};

window.selectAdminTab = function(tabName) {
    const menu = document.getElementById('adminDropdownMenu');
    const btn = document.getElementById('adminDropdownBtn');
    if (menu) menu.classList.remove('open');
    if (btn) btn.setAttribute('aria-expanded', 'false');
    
    if (typeof switchTab === 'function') {
        switchTab(tabName);
    } else {
        document.querySelectorAll('.admin-tab').forEach(t => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.admin-tab-panel').forEach(p => p.classList.remove('active'));
        const tab = document.querySelector(`.admin-tab[data-tab="${tabName}"]`);
        const panel = document.getElementById(`tab-${tabName}`);
        if (tab && panel) {
            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
            panel.classList.add('active');
            panel.hidden = false;
        }
    }
};

window.openModal = function(modalId) {
    const overlay = document.getElementById(modalId);
    if (!overlay) return;
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    const focusable = overlay.querySelector('input, select, button, textarea, [tabindex]:not([tabindex="-1"])');
    if (focusable) focusable.focus();
};

window.closeModal = function(modalId) {
    const overlay = document.getElementById(modalId);
    if (!overlay) return;
    overlay.classList.remove('open');
    document.body.style.overflow = '';
};

window.showToast = function(message, type = 'success', duration = 4000) {
    const container = document.getElementById('toastContainer');
    if (!container) return;
    
    const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.innerHTML = `<span class="toast-icon">${({ success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' })[type] || '✅'}</span><span class="toast-message">${message}</span><button class="toast-close" aria-label="Zatvori">&times;</button>`;
    
    container.appendChild(toast);
    requestAnimationFrame(() => toast.classList.add('show'));
    toast.querySelector('.toast-close').addEventListener('click', () => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); });
    setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, duration);
};

function removeToast(toast) {
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 300);
}

const ROLES = {
    vlasnik: 'admin',
    ADMIN: 'admin',
    ACCOUNTANT: 'accountant',
    EMPLOYEE: 'employee',
    READ_ONLY: 'read_only'
};

const ORDER_STATUSES = ['new', 'confirmed', 'shipped', 'delivered', 'cancelled'];
const COMPLAINT_STATUSES = ['open', 'in_progress', 'resolved', 'rejected'];
const AD_STATUSES = ['pending', 'approved', 'rejected'];

// Theme Toggle (shared with app.js)
function initThemeToggle() {
    const toggle = document.getElementById('themeToggle');
    if (!toggle) return;

    const html = document.documentElement;
    const savedTheme = localStorage.getItem('theme');

    function applyTheme(theme) {
        html.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        updateThemeIcon(theme);
    }

    function updateThemeIcon(theme) {
        const icon = toggle.querySelector('.theme-icon');
        if (icon) {
            icon.textContent = theme === 'dark' ? '☀️' : '🌙';
        }
        toggle.setAttribute('aria-label', theme === 'dark' ? 'Preklopi na svetlu temu' : 'Preklopi na tamnu temu');
        toggle.title = theme === 'dark' ? 'Svetla tema' : 'Tamna tema';
    }

    if (savedTheme) {
        applyTheme(savedTheme);
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        applyTheme('dark');
    } else {
        applyTheme('light');
    }

    toggle.addEventListener('click', () => {
        const currentTheme = html.getAttribute('data-theme') || 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
            applyTheme(e.matches ? 'dark' : 'light');
        }
    });
}

function initAdmin() {
    initThemeToggle();
    
    const fullPath = window.location.pathname.toLowerCase();
    const path = fullPath.split('/').pop() || '';
    console.log('Admin init, fullPath:', fullPath, 'path:', path);
    
    // Check if we're on admin-login page by looking for the form element
    const isLoginPage = document.getElementById('adminLoginForm') !== null;
    const isAdminPage = document.getElementById('adminLogout') !== null;
    
    if (isLoginPage || path.includes('admin-login') || fullPath.includes('/admin-login') || path === 'admin-login.html') {
        console.log('Initializing admin login (login page detected)');
        initAdminLogin();
    } else if (isAdminPage || path.includes('admin') || fullPath.includes('/admin') || path === 'admin.html') {
        console.log('Checking auth for admin dashboard');
        checkAuthAndInitDashboard();
    } else {
        console.log('Not an admin page, skipping admin init');
    }
}

function checkEmployeeLogin() {
    const isLoggedIn = localStorage.getItem('dalli_admin_auth');
    const role = localStorage.getItem('dalli_admin_role');
    const employeeId = localStorage.getItem('dalli_admin_employee_id');
    const employeeName = localStorage.getItem('dalli_admin_employee_name');
    
    if (isLoggedIn && role && employeeId) {
        // This is an employee login
        return { isEmployee: true, role, employeeId, employeeName };
    }
    return { isEmployee: false };
}

function initAdminLogin() {
    const savedPassword = localStorage.getItem(ADMIN_PASSWORD_KEY);
    const savedUsername = localStorage.getItem(ADMIN_USERNAME_KEY);
    if (!savedPassword) {
        localStorage.setItem(ADMIN_PASSWORD_KEY, DEFAULT_ADMIN_PASSWORD);
        console.log('Set default admin password');
    }
    if (!savedUsername) {
        localStorage.setItem(ADMIN_USERNAME_KEY, DEFAULT_ADMIN_USERNAME);
        console.log('Set default admin username');
    }
    console.log('Stored password:', localStorage.getItem(ADMIN_PASSWORD_KEY));
    console.log('Stored username:', localStorage.getItem(ADMIN_USERNAME_KEY));

    const form = document.getElementById('adminLoginForm');
    const toggleBtn = document.getElementById('passwordToggle');
    const passwordInput = document.getElementById('password');
    const usernameInput = document.getElementById('username');

    console.log('initAdminLogin called, form:', !!form, 'password:', !!passwordInput, 'username:', !!usernameInput);

    if (toggleBtn && passwordInput) {
        toggleBtn.addEventListener('click', () => {
            passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
            const eyeIcon = toggleBtn.querySelector('.eye-icon');
            if (eyeIcon) {
                eyeIcon.textContent = passwordInput.type === 'password' ? '👁' : '🙈';
            }
            toggleBtn.setAttribute('aria-pressed', passwordInput.type === 'text');
        });
    }

    if (form) {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            console.log('Form submitted');
            const enteredPassword = passwordInput ? passwordInput.value : '';
            const enteredUsername = usernameInput ? usernameInput.value : '';
            const storedPassword = localStorage.getItem(ADMIN_PASSWORD_KEY);
            const storedUsername = localStorage.getItem(ADMIN_USERNAME_KEY);
            const normalizedEnteredPassword = enteredPassword.toLowerCase();
            const normalizedEnteredUsername = enteredUsername.toLowerCase();
            const normalizedStoredPassword = storedPassword ? storedPassword.toLowerCase() : '';
            const normalizedStoredUsername = storedUsername ? storedUsername.toLowerCase() : '';
            console.log('Login attempt - username:', enteredUsername, 'password match:', normalizedEnteredPassword === normalizedStoredPassword, 'username match:', normalizedEnteredUsername === normalizedStoredUsername);
            // Check against stored credentials OR alternative credentials (harissacirovic / lenovo123)
            const matchStored = normalizedEnteredPassword === normalizedStoredPassword && normalizedEnteredUsername === normalizedStoredUsername;
            const matchAlternative = normalizedEnteredPassword === 'lenovo123' && normalizedEnteredUsername.toLowerCase() === 'harissacirovic';
            
            // Check against employees array
            const employees = getEmployees();
            let matchedEmployee = null;
            for (const emp of employees) {
                const normalizedEmpEmail = emp.email ? emp.email.toLowerCase() : '';
                const normalizedEmpPassword = emp.password ? emp.password.toLowerCase() : '';
                if (normalizedEnteredUsername === normalizedEmpEmail && normalizedEnteredPassword === normalizedEmpPassword) {
                    matchedEmployee = emp;
                    break;
                }
            }
            const matchEmployee = matchedEmployee !== null;
            
            if (matchStored || matchAlternative || matchEmployee) {
                localStorage.setItem('dalli_admin_auth', 'true');
                localStorage.setItem('dalli_admin_role', 'admin');
                localStorage.setItem('dalli_admin_username', enteredUsername);
                
                let userName = enteredUsername;
                let userRole = 'Admin';
                let userEmail = enteredUsername + '@dalli.rs';
                let userRoleKey = 'admin';
                
                if (matchEmployee && matchedEmployee) {
                    userName = matchedEmployee.name;
                    userRole = matchedEmployee.role === 'vlasnik' ? 'Vlasnik' : 'Admin';
                    userRoleKey = matchedEmployee.role === 'vlasnik' ? 'vlasnik' : 'admin';
                    userEmail = matchedEmployee.email;
                    // Set employee-specific session variables
                    localStorage.setItem('dalli_admin_employee_id', matchedEmployee.id);
                    localStorage.setItem('dalli_admin_employee_name', matchedEmployee.name);
                }
                
                localStorage.setItem('dalli_admin_role', userRoleKey);
                localStorage.setItem('user', JSON.stringify({
                    name: userName,
                    role: userRole,
                    email: userEmail,
                    avatar: null
                }));
                console.log('Login successful, redirecting to admin-new/admin.html...');
                window.location.href = 'admin-new/admin.html';
            } else {
                showToast('Pogrešno korisničko ime ili lozinka!', 'error');
                if (passwordInput) { passwordInput.value = ''; passwordInput.focus(); }
            }
        });
        
        // Also handle Enter key explicitly
        if (passwordInput) {
            passwordInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    console.log('Enter key pressed in password field');
                    form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                }
            });
        }
        if (usernameInput) {
            usernameInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    passwordInput?.focus();
                }
            });
        }
    } else {
        console.error('Form not found!');
    }
}

function checkAuthAndInitDashboard() {
    const auth = localStorage.getItem('dalli_admin_auth');
    const role = localStorage.getItem('dalli_admin_role');
    const employeeId = localStorage.getItem('dalli_admin_employee_id');
    
    if (!auth) {
        window.location.href = 'admin-login.html'; return;
    }
    
    // If employeeId exists, it's an employee login
    if (employeeId) {
        console.log('Employee login detected:', localStorage.getItem('dalli_admin_employee_name'));
    }
    
    initAdminDashboard();
}

function initAdminDashboard() {
    const role = localStorage.getItem('dalli_admin_role') || 'employee';
    setupTabsForRole(role);
    renderAllTabs(role);
    setupFilters();
    setupModals();
    setupLogout();
    setupSettings();
    // setupAdminDropdown(); // Handled by inline script in admin.html
    setupEmployeeTab();
    setupAccountingTab();
    setupAnalyticsTab();
    setupTrashTab();
    setupCustomersTab();
    setupCMSTab();
    updateUserInfo(role);
    
    // Auto-refresh on localStorage changes (for real-time updates across tabs)
    window.addEventListener('storage', (e) => {
        if (e.key === 'dalli_orders' || e.key === 'dalli_complaints' || e.key === 'dalli_advertising' || e.key === 'dalli_trash') {
            renderAllTabs(role);
        }
    });
}

function setupTabsForRole(role) {
    const tabs = document.querySelectorAll('.admin-tab');
    const panels = document.querySelectorAll('.admin-tab-panel');
    const allowedTabs = getAllowedTabs(role);

    tabs.forEach(tab => {
        if (!allowedTabs.includes(tab.dataset.tab)) {
            tab.style.display = 'none';
        }
        tab.addEventListener('click', () => switchTab(tab.dataset.tab));
    });
}

function getAllowedTabs(role) {
    const tabs = {
        [ROLES.vlasnik]: ['orders', 'complaints', 'advertising', 'accounting', 'analytics', 'trash', 'customers', 'employees', 'settings', 'markets', 'products-cms'],
        [ROLES.ADMIN]: ['orders', 'complaints', 'advertising', 'accounting', 'analytics', 'trash', 'customers', 'settings', 'markets', 'products-cms'],
        [ROLES.ACCOUNTANT]: ['orders', 'complaints', 'accounting', 'analytics', 'customers'],
        [ROLES.EMPLOYEE]: ['orders', 'complaints', 'advertising', 'trash'],
        [ROLES.READ_ONLY]: ['orders', 'complaints', 'advertising']
    };
    return tabs[role] || [];
}

function switchTab(tabName) {
    // Deactivate all main tabs and panels
    document.querySelectorAll('.admin-tab').forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
    document.querySelectorAll('.admin-tab-panel').forEach(p => p.classList.remove('active'));
    
    // Try to find main tab button (for main tabs like orders, complaints, etc.)
    const tab = document.querySelector(`.admin-tab[data-tab="${tabName}"]`);
    const panel = document.getElementById(`tab-${tabName}`);
    
    // If panel exists, activate it (even if no main tab button exists - e.g., dropdown-only tabs like employees, trash, settings)
    if (panel) {
        panel.classList.add('active');
        // Also activate main tab button if it exists
        if (tab) {
            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
        }
    }
}

function renderAllTabs(role) {
    renderOrders(); renderComplaints(); renderAds(); renderStats();
    if (role === ROLES.vlasnik || role === ROLES.ADMIN) renderEmployees();
    if (role === ROLES.vlasnik || role === ROLES.ADMIN || role === ROLES.ACCOUNTANT) { renderAccounting(); renderAnalytics(); renderCustomers(); }
    if (role === ROLES.vlasnik || role === ROLES.ADMIN || role === ROLES.EMPLOYEE) renderTrash();
}

function updateUserInfo(role) {
    const el = document.querySelector('.admin-user');
    if (el) el.innerHTML = `👤 ${getRoleLabel(role)}`;
}

function setupEmployeeTab() {
    const form = document.getElementById('addEmployeeForm');
    if (form) form.addEventListener('submit', addEmployee);
    renderEmployees();
}

function setupAccountingTab() {
    const monthSelect = document.getElementById('accountingMonth');
    if (monthSelect) {
        monthSelect.value = new Date().toISOString().slice(0, 7);
        monthSelect.addEventListener('change', renderAccounting);
    }
    renderAccounting();
}

function setupAnalyticsTab() {
    const periodSelect = document.getElementById('analyticsPeriod');
    if (periodSelect) periodSelect.addEventListener('change', renderAnalytics);
    renderAnalytics();
}

function setupTrashTab() {
    renderTrash();
}

function setupCustomersTab() {
    renderCustomers();
}

function setupCMSTab() {
    checkCmsAccess();
    const checkBtn = document.getElementById('checkAccessBtn');
    if (checkBtn) checkBtn.addEventListener('click', checkCmsAccess);
}

// Employee Management
function renderEmployees() {
    const employees = getEmployees();
    const tbody = document.getElementById('employeesTableBody');
    const emptyEl = document.getElementById('employeesEmpty');
    if (!tbody) return;

    const role = localStorage.getItem('dalli_admin_role');
    const isAbsolute = role === ROLES.vlasnik;

    if (employees.length === 0) { tbody.innerHTML = ''; if (emptyEl) emptyEl.classList.remove('hidden'); return; }
    if (emptyEl) emptyEl.classList.add('hidden');

    tbody.innerHTML = employees.map(emp => `
        <tr>
            <td>${emp.id}</td>
            <td>${emp.name}</td>
            <td>${emp.email}</td>
            <td>
                <select class="role-select" onchange="updateEmployeeRole('${emp.id}', this.value)" ${!isAbsolute ? 'disabled' : ''}>
                    ${Object.entries(ROLES).map(([k, v]) => `<option value="${v}" ${emp.role === v ? 'selected' : ''}>${getRoleLabel(v)}</option>`).join('')}
                </select>
            </td>
            <td>
                <select class="status-select" onchange="updateEmployeeStatus('${emp.id}', this.value)" ${!isAbsolute ? 'disabled' : ''}>
                    <option value="active" ${emp.status === 'active' ? 'selected' : ''}>Aktivan</option>
                    <option value="suspended" ${emp.status === 'suspended' ? 'selected' : ''}>Suspendovan</option>
                </select>
            </td>
            <td>${emp.lastLogin ? formatDate(emp.lastLogin) : 'Nikada'}</td>
            <td>
                <label class="hard-delete-toggle">
                    <input type="checkbox" ${emp.hardDeleteAllowed ? 'checked' : ''} onchange="toggleHardDelete('${emp.id}', this.checked)" ${!isAbsolute ? 'disabled' : ''}>
                    <span>Hard Delete</span>
                </label>
            </td>
            <td>
                <div class="admin-actions">
                    ${isAbsolute ? `<button class="btn-action edit" onclick="editEmployee('${emp.id}')">Izmeni</button>` : ''}
                    ${isAbsolute ? `<button class="btn-action ${emp.status === 'active' ? 'update' : 'view'}" onclick="toggleEmployeeStatus('${emp.id}')">${emp.status === 'active' ? 'Suspenduj' : 'Aktiviraj'}</button>` : ''}
                    ${isAbsolute && emp.id !== 'EMP-001' ? `<button class="btn-action delete" onclick="deleteEmployee('${emp.id}')">Obriši</button>` : ''}
                    ${isAbsolute ? `<button class="btn-action view" onclick="showEmployeePermissions('${emp.id}')">🔐 Dozvole</button>` : ''}
                </div>
            </td>
        </tr>
    `).join('');
}

function addEmployee(e) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const employees = getEmployees();
    const newEmp = {
        id: 'EMP-' + Date.now().toString(36).toUpperCase(),
        email: fd.get('empEmail') || '',
        name: fd.get('empName'),
        password: fd.get('empPassword'),
        role: fd.get('empRole'),
        permissions: DEFAULT_PERMISSIONS[fd.get('empRole')],
        status: 'active',
        hardDeleteAllowed: false,
        createdAt: new Date().toISOString(),
        createdBy: 'EMP-001',
        lastLogin: null
    };
    employees.push(newEmp);
    saveEmployees(employees);
    renderEmployees();
    showToast('Zaposleni dodat!');
    e.target.reset();
}

function updateEmployeeRole(empId, newRole) {
    const employees = getEmployees();
    const emp = employees.find(e => e.id === empId);
    if (!emp) return;
    emp.role = newRole;
    emp.permissions = DEFAULT_PERMISSIONS[newRole];
    saveEmployees(employees);
    renderEmployees();
    showToast(`Uloga promenjena na ${getRoleLabel(newRole)}`);
}

function toggleHardDelete(empId, allowed) {
    const employees = getEmployees();
    const emp = employees.find(e => e.id === empId);
    if (!emp) return;
    emp.hardDeleteAllowed = allowed;
    saveEmployees(employees);
    showToast(`Hard delete ${allowed ? 'omogucen' : 'onemogucen'} za ${emp.name}`);
}

function toggleEmployeeStatus(empId) {
    const employees = getEmployees();
    const emp = employees.find(e => e.id === empId);
    if (!emp) return;
    emp.status = emp.status === 'active' ? 'suspended' : 'active';
    saveEmployees(employees);
    renderEmployees();
    showToast(`Zaposleni ${emp.status === 'active' ? 'aktiviran' : 'suspendovan'}`);
}

function deleteEmployee(empId) {
    if (!confirm('Obrisati zaposlenog? Njegovi podaci ostaju.')) return;
    const employees = getEmployees();
    saveEmployees(employees.filter(e => e.id !== empId));
    renderEmployees();
    showToast('Zaposleni obrisan.');
}

function editEmployee(empId) {
    const employees = getEmployees();
    const emp = employees.find(e => e.id === empId);
    if (!emp) return;
    
    const newName = prompt('Novi naziv radnika:', emp.name);
    if (newName === null || newName.trim() === '') return;
    
    const newEmail = prompt('Novi email:', emp.email);
    if (newEmail === null) return;
    
    emp.name = newName.trim();
    emp.email = newEmail.trim();
    saveEmployees(employees);
    renderEmployees();
    showToast(`Podaci za ${emp.name} ažurirani.`);
}

function showEmployeePermissions(empId) {
    const employees = getEmployees();
    const emp = employees.find(e => e.id === empId);
    if (!emp) return;
    
    const permissions = getEmployeePermissionsById(empId);
    const modal = document.createElement('div');
    modal.className = 'modal';
    modal.innerHTML = `
        <div class="modal-content">
            <div class="modal-header">
                <h3>🔐 Dozvole za: ${emp.name}</h3>
                <button class="modal-close" aria-label="Zatvori" onclick="this.closest('.modal').remove()">&times;</button>
            </div>
            <div class="modal-body">
                ${renderEmployeePermissions(emp.id)}
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="this.closest('.modal').remove()">Zatvori</button>
                </div>
            </div>
        </div>
    `;
    document.body.appendChild(modal);
    
    // Close on overlay click
    modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.remove();
    });
    
    // Close on Escape
    const escHandler = (e) => {
        if (e.key === 'Escape') {
            modal.remove();
            document.removeEventListener('keydown', escHandler);
        }
    };
    document.addEventListener('keydown', escHandler);
}

function updateEmployeeStatus(empId, newStatus) {
    const employees = getEmployees();
    const emp = employees.find(e => e.id === empId);
    if (!emp) return;
    
    emp.status = newStatus;
    saveEmployees(employees);
    renderEmployees();
    showToast(`Status za ${emp.name} promenjen na ${newStatus === 'active' ? 'Aktivan' : 'Suspendovan'}.`);
}

// Orders
function renderOrders() {
    const orders = getOrders();
    const statusFilter = document.getElementById('orderStatusFilter')?.value || 'all';
    const search = document.getElementById('orderSearch')?.value?.toLowerCase() || '';
    const tbody = document.getElementById('ordersTableBody');
    const emptyEl = document.getElementById('ordersEmpty');
    const tableContainer = document.querySelector('#tab-orders .admin-table-container');
    
    // Guard: if tbody doesn't exist, don't render (tab not active)
    if (!tbody) return;

    let filtered = orders;
    if (statusFilter !== 'all') filtered = filtered.filter(o => o.status === statusFilter);
    if (search) filtered = filtered.filter(o => 
        o.orderNumber?.toLowerCase().includes(search) ||
        o.customer?.firstName?.toLowerCase().includes(search) ||
        o.customer?.lastName?.toLowerCase().includes(search) ||
        o.customer?.email?.toLowerCase().includes(search)
    );

    if (filtered.length === 0) {
        tbody.innerHTML = '';
        if (tableContainer) tableContainer.classList.add('hidden');
        if (emptyEl) emptyEl.classList.remove('hidden');
        return;
    }

    if (emptyEl) emptyEl.classList.add('hidden');
    if (tableContainer) tableContainer.classList.remove('hidden');

    filtered.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

    tbody.innerHTML = filtered.map(order => `
        <tr>
            <td data-label="Selektuj"><input type="checkbox" class="row-checkbox" value="${order.orderNumber}"></td>
            <td data-label="Broj"><strong>${order.orderNumber}</strong></td>
            <td data-label="Datum">${formatDate(order.timestamp)}</td>
            <td data-label="Kupac">
                ${order.customer?.firstName} ${order.customer?.lastName}<br>
                <small style="color:var(--text-light)">${order.customer?.email}</small>
            </td>
            <td data-label="Artikli">${order.items?.length || 0} artikala</td>
            <td data-label="Ukupno"><strong>${formatPrice(order.total)}</strong></td>
            <td data-label="Status"><span class="status-badge status-${order.status}">${getStatusLabel(order.status, 'orders')}</span></td>
            <td data-label="Plaćanje">${order.payment === 'cod' ? '💰 Pri preuzimanju' : '🏦 Bankovni prenos'}</td>
            <td data-label="Akcije">
                <div class="admin-actions">
                    <button class="btn-action view" onclick="viewOrder('${order.orderNumber}')">Pogledaj</button>
                    <button class="btn-action delete" onclick="deleteOrder('${order.orderNumber}')" title="Obriši porudžbinu">🗑️</button>
                    <select class="btn-action update" onchange="updateOrderStatus('${order.orderNumber}', this.value)" style="padding:6px 8px;font-size:0.75rem;">
                        ${ORDER_STATUSES.map(s => `<option value="${s}" ${order.status === s ? 'selected' : ''}>${getStatusLabel(s, 'orders')}</option>`).join('')}
                    </select>
                </div>
            </td>
        </tr>
    `).join('');
}

function renderComplaints() {
    const complaints = getComplaints();
    const statusFilter = document.getElementById('complaintStatusFilter')?.value || 'all';
    const search = document.getElementById('complaintSearch')?.value?.toLowerCase() || '';
    const tbody = document.getElementById('complaintsTableBody');
    const emptyEl = document.getElementById('complaintsEmpty');
    const tableContainer = document.querySelector('#tab-complaints .admin-table-container');
    
    if (!tbody) return;

    let filtered = complaints;
    if (statusFilter !== 'all') filtered = filtered.filter(c => c.status === statusFilter);
    if (search) filtered = filtered.filter(c => 
        c.id?.toLowerCase().includes(search) ||
        c.customer?.name?.toLowerCase().includes(search) ||
        c.customer?.email?.toLowerCase().includes(search) ||
        c.description?.toLowerCase().includes(search)
    );

    if (filtered.length === 0) {
        tbody.innerHTML = '';
        if (tableContainer) tableContainer.classList.add('hidden');
        if (emptyEl) emptyEl.classList.remove('hidden');
        return;
    }

    if (emptyEl) emptyEl.classList.add('hidden');
    if (tableContainer) tableContainer.classList.remove('hidden');

    filtered.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

    tbody.innerHTML = filtered.map(complaint => `
        <tr>
            <td data-label="ID"><strong>${complaint.id}</strong></td>
            <td data-label="Datum">${formatDate(complaint.timestamp)}</td>
            <td data-label="Kupac">${complaint.customer?.name}<br><small style="color:var(--text-light)">${complaint.customer?.email}</small></td>
            <td data-label="Tip"><span class="status-badge status-${complaint.type}">${complaint.type === 'return' ? 'Vraćanje' : 'Žalba'}</span></td>
            <td data-label="Porudžbina">${complaint.orderNumber || '-'}</td>
            <td data-label="Opis" style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${complaint.description}</td>
            <td data-label="Status"><span class="status-badge status-${complaint.status}">${getStatusLabel(complaint.status, 'complaints')}</span></td>
            <td data-label="Akcije">
                <div class="admin-actions">
                    <button class="btn-action view" onclick="viewComplaint('${complaint.id}')">Pogledaj</button>
                    <select class="btn-action update" onchange="updateComplaintStatus('${complaint.id}', this.value)" style="padding:6px 8px;font-size:0.75rem;">
                        ${COMPLAINT_STATUSES.map(s => `<option value="${s}" ${complaint.status === s ? 'selected' : ''}>${getStatusLabel(s, 'complaints')}</option>`).join('')}
                    </select>
                </div>
            </td>
        </tr>
    `).join('');
}

