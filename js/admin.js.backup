            <td data-label="Tip"><span class="status-badge status-${ad.type}">${ad.type === 'banner' ? 'Banner' : ad.type === 'sponsored' ? 'Sponsorirano' : 'Partnerstvo'}</span></td>
            <td data-label="Budžet">${ad.budget ? formatPrice(ad.budget) : 'Nije naveden'}</td>
            <td data-label="Poruka" style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${ad.message}</td>
            <td data-label="Status"><span class="status-badge status-${ad.status}">${getStatusLabel(ad.status, 'ads')}</span></td>
