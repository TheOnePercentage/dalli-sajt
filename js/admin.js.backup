                        ${AD_STATUSES.map(s => `<option value="${s}" ${ad.status === s ? 'selected' : ''}>${getStatusLabel(s, 'ads')}</option>`).join('')}
                    </select>
                </div>
            </td>
        </tr>
    `).join('');
}

function renderStats() {
    const orders = getOrders();
    const complaints = getComplaints();
    
    const totalOrders = orders.length;
    const totalRevenue = orders.reduce((sum, o) => sum + (o.total || 0), 0);
    const pendingOrders = orders.filter(o => o.status === 'new' || o.status === 'confirmed').length;
    const openComplaints = complaints.filter(c => c.status === 'open' || c.status === 'in_progress').length;

    const statTotalOrders = document.getElementById('statTotalOrders');
    const statTotalRevenue = document.getElementById('statTotalRevenue');
    const statPendingOrders = document.getElementById('statPendingOrders');
    const statOpenComplaints = document.getElementById('statOpenComplaints');
    
    if (statTotalOrders) statTotalOrders.textContent = totalOrders;
    if (statTotalRevenue) statTotalRevenue.textContent = formatPrice(totalRevenue);
    if (statPendingOrders) statPendingOrders.textContent = pendingOrders;
    if (statOpenComplaints) statOpenComplaints.textContent = openComplaints;
}

