{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "vueIndentScriptAndStyle": true,
  "plugins": ["prettier-plugin-organize-imports"],
  "importOrder": [
    "^(react|react-dom|react-router-dom)$",
    "^(vue|vue-router|pinia)$",
    "^(svelte|svelte/store)$",
    "^(solid-js|solid-js/store)$",
    "^(preact|preact/hooks|preact/router)$",
    "^(lit|lit-html)$",
    "^(alpinejs)$",
    "^(htm|htm/preact)$",
    "^(marko)$",
    "^(qwik|@builder.io/qwik)$",
    "^(astro|astro/*)$",
    "^(remix|@remix-run/*)$",
    "^(next|next/*)$",
    "^(nuxt|nuxt/*)$",
    "^(sveltekit|sveltekit/*)$",
    "^(vite|vite/*)$",
    "^(vitepress|vitepress/*)$",
    "^(rollup|esbuild|swc|swc-loader)$",
    "^(webpack|webpack/*)$",
    "^(rollup|esbuild|swc|swc-loader)$",
    "^(eslint|eslint/*)$",
    "^(prettier|prettier/*)$",
    "^(stylelint|stylelint/*)$",
    "^(typescript|typescript/*)$",
    "^(vite-plugin-*)$",
    "^(vite-plugin-*)$",
    "^@",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderCaseInsensitive": true
}