{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run preview",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/products",
        "http://localhost:4173/products/hoodie-black-xl",
        "http://localhost:4173/collections/summer-essentials-2025",
        "http://localhost:4173/locations/beograd-centar",
        "http://localhost:4173/blog/osnovna-majica-za-svakodnevno-wear"
      ],
      "settings": {
        "budget": [
          {
            "resourceSizes": [
              {"resourceType": "total", "budget": 500},
              {"resourceType": "script", "budget": 150},
              {"resourceType": "css", "budget": 50},
              {"resourceType": "image", "budget": 200},
              {"resourceType": "font", "budget": 50},
              {"resourceType": "third-party", "budget": 100}
            ],
            "resourceCounts": [
              {"resourceType": "third-party", "budget": 10}
            ]
          },
          "staticDistDir": "./dist"
        }
      },
      "assert": {
        "assertions": {
          "categories:performance": ["error", {"minScore": 0.9}],
          "categories:accessibility": ["error", {"minScore": 0.9}],
          "categories:best-practices": ["error", {"minScore": 0.9}],
          "categories:seo": ["error", {"minScore": 0.9}],
          "categories:pwa": ["warn", {"minScore": 0.5}],
          "first-contentful-paint": ["error", {"maxNumericValue": 1800}],
          "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
          "interactive": ["error", {"maxNumericValue": 3000}],
          "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
          "first-input-delay": ["warn", {"maxNumericValue": 100}],
          "total-blocking-time": ["error", {"maxNumericValue": 300}],
          "speed-index": ["warn", {"maxNumericValue": 3500}],
          "redirects": ["error", {"maxNumericValue": 0}],
          "server-response-time": ["warn", {"maxNumericValue": 600}],
          "uses-long-cache-ttl": ["warn", {"minScore": 0.8}],
          "uses-text-compression": ["warn", {"minScore": 0.8}],
          "image-alt": ["error", {"minScore": 0.9}],
          "font-display": ["warn", {"minScore": 0.8}],
          "html-has-lang": ["error", {"minScore": 1}],
          "document-title": ["error", {"minScore": 1}],
          "meta-description": ["error", {"minScore": 0.9}],
          "html-lang-valid": ["error", {"minScore": 1}],
          "viewport": ["error", {"minScore": 1}],
          "tap-targets": ["warn", {"minScore": 0.8}],
          "managed-autoplay": ["error", {"minScore": 1}],
          "no-document-write": ["error", {"minScore": 1}],
          "no-vulnerable-libraries": ["error", {"minScore": 1}],
          "html-doctype": ["error", {"minScore": 1}],
          "uses-passive-event-listeners": ["warn", {"minScore": 0.8}],
          "uses-rel-preconnect": ["warn", {"minScore": 0.5}],
          "font-display": ["warn", {"minScore": 0.8}],
          "efficient-animated-content": ["warn", {"minScore": 0.8}],
          "duplicated-javascript": ["warn", {"minScore": 0.8}],
          "legacy-javascript": ["warn", {"minScore": 0.8}],
          "modern-image-formats": ["warn", {"minScore": 0.8}],
          "uses-webp-images": ["warn", {"minScore": 0.8}],
          "uses-responsive-images": ["warn", {"minScore": 0.8}],
          "uses-text-compression": ["warn", {"minScore": 0.8}],
          "offscreen-images": ["warn", {"minScore": 0.8}],
          "render-blocking-resources": ["warn", {"minScore": 0.8}],
          "unminified-css": ["warn", {"minScore": 0.8}],
          "unminified-javascript": ["warn", {"minScore": 0.8}"],
          "unused-css-rules": ["warn", {"minScore": 0.8}],
          "unused-javascript": ["warn", {"minScore": 0.8}],
          "legacy-javascript": ["warn", {"minScore": 0.8}],
          "dom-size": ["warn", {"maxNumericValue": 1500}],
          "bootup-time": ["warn", {"maxNumericValue": 1000}],
          "mainthread-work-breakdown": ["warn", {"minScore": 0.8}],
          "third-party-summary": ["info", {"minScore": 0}],
          "total-byte-weight": ["warn", {"maxNumericValue": 500000}],
          "third-party-summary": ["warn", {"maxNumericValue": 100000}]
        }
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}