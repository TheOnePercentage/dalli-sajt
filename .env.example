# ============================================================================
# DALLI — .env.example (single source of truth za sve servise)
#
# Ovaj fajl je TEMPLATE. Kopiraj u:
#   - root `.env`                 (lokalni dev; server ga čita kroz
#                                  `node --env-file-if-exists=../.env`)
#   - `server/.env`               (kada server pokrećeš iz server/)
#   - Netlify Site Env Variables  (storefront + functions)
#   - GitHub repo secrets         (ci.yml / deploy.yml)
#   - API host env                (Docker / systemd / k8s)
#
# Vrednosti su PRIMERI — zameni svaku po environment (preview/production).
# Generisanje tajni: `openssl rand -base64 32`
# ----------------------------------------------------------------------------
# Oznake: [REQ] obavezno · [OPT] opciono · [CI] samo CI · [DEV] samo dev/setup
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL — Neon [REQ]
# ----------------------------------------------------------------------------
# Neon connection string za Prisma/API.
# S preporučenim pooler-om (pgbouncer) URL mora biti:
#   postgresql://<user>:<pass>@<host>.pooler.neon.tech/<db>?pgbouncer=true&connection_limit=1&schema=public
# (Neon → Dashboard → Connection string; pooler URL detalji u DEPLOYMENT_GUIDE.md §4.)
# Lokalni/dev: postgresql://dalli:pass@localhost:5432/dalli?schema=public
DATABASE_URL="postgresql://dalli:replace-me@db.pooler.neon.tech/dalli?pgbouncer=true&connection_limit=1&schema=public"

# Test baza za scripts/setup-test-db.mjs i run-api-tests.mjs [CI/DEV]
TEST_DB="dalli_test"
TEST_PORT=3100

# ----------------------------------------------------------------------------
# Upstash Redis — cache + rate-limit (+ socket adapter) [REQ za multi-instance]
# ----------------------------------------------------------------------------
# Upstash "TCP/Redis" connection string iz Dashboard-a (ioredis klijent):
#   rediss://default:<token>@<region>.upstash.io:<port>
# Upstash REST URL NIJE podržan za ioredis — koristi TCP endpoint.
# Bez ove vrednosti server pada na in-memory cache (safe, dev-ok).
REDIS_URL="rediss://default:replace-me@us1-caring-seahorse-12345.upstash.io:6379"

# ----------------------------------------------------------------------------
# JWT / sesija [REQ — HITNO promeniti od dev fallback-a]
# ----------------------------------------------------------------------------
# Bez ovih env-ova server tiho pada na hardkodovane dev tajne
# (server/src/lib/auth.js) — NEPRIHVATLJIVO u produkciji.
JWT_SECRET="generate-with: openssl rand -base64 32"
JWT_REFRESH_SECRET="generate-with: openssl rand -base64 32"

# ----------------------------------------------------------------------------
# Server [REQ]
# ----------------------------------------------------------------------------
PORT=3001
NODE_ENV=production

# CORS allowlist (CSV; uvek sadrži localhost-eve + https://dalli.rs u kodu)
FRONTEND_URL="https://dalli.rs,https://www.dalli.rs"

# ----------------------------------------------------------------------------
# Kripto checkout [OPT — ima sensible defaults u kodu]
# ----------------------------------------------------------------------------
CRYPTO_DISCOUNT_PERCENT=15
CRYPTO_RATE_RSD=10000000

# ----------------------------------------------------------------------------
# Meilisearch [OPT — search; opcionalni servis]
# ----------------------------------------------------------------------------
MEILI_HOST="https://search.dalli.rs"
MEILI_API_KEY="replace-with-meili-master-key"

# ----------------------------------------------------------------------------
# Email (Netlify function send-email) [OPT]
# ----------------------------------------------------------------------------
SMTP_HOST="smtp.dalli.rs"
SMTP_PORT=587
SMTP_USER="noreply@dalli.rs"
SMTP_PASS="replace-me"
EMAIL_FROM="DALLI <noreply@dalli.rs>"

# ----------------------------------------------------------------------------
# Netlify Functions / Blobs / Edge [REQ za functions: experience, promotions,
# redirects, languages, scheduled-audit, theme-injector]
# ----------------------------------------------------------------------------
# NETLIFY_SITE_ID postavlja Netlify UI automatski; AUTH_TOKEN iz
# Netlify user settings → personal access tokens.
NETLIFY_SITE_ID="replace-with-netlify-site-id"
NETLIFY_AUTH_TOKEN="replace-with-netlify-personal-token"

# URL sajta za scheduled-audit + edge (sitemap/SEO provere) [REQ]
SITE_URL="https://dalli.rs"
# Webhook za alertovanje (Slack/Discord incoming webhook) [OPT]
ALERT_WEBHOOK_URL=""
# API koji Netlify search funkcija koristi kao upstream [REQ — public API URL]
API_URL="https://api.dalli.rs"

# ----------------------------------------------------------------------------
# Build [OPT]
# ----------------------------------------------------------------------------
# Generisane kategorije/produkt stranice upisuje u custom directory
GENERATE_OUTPUT_DIR=""

# ----------------------------------------------------------------------------
# Seed (scripts/seed-rbac.js) — SAMO dev/init. Dobra praksa: UOPŠTE ne puniti
# u prod; ako se koristi, promeniti odmah posle prvog seed-a. [DEV]
# ----------------------------------------------------------------------------
SEED_PASSWORD="change-me"

# ============================================================================
# Docker Compose (docker-compose.yml) — za self-hosted VPS APLAN
# ============================================================================
# Koristi ih `docker compose up`; lokalni dev NE treba ove.
# ----------------------------------------------------------------------------
# Postgres lozinka (mount-ovan u postgres + DATABASE_URL kompoziciju)
POSTGRES_PASSWORD="dalli_secure_password_change_in_production"
# Meilisearch master key (MEILI_API_KEY u compose-u čita ovu istu promenljivu)
MEILI_MASTER_KEY="dalli_master_key"

# ============================================================================
# Rezervisano / dokumentovano — trenutno NIJE pročitano u kodu:
#   RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX_REQUESTS  (throttle hardcoded 120/min
#                                                    u server/index.js:67)
#   CRYPTO_WEBHOOK_SECRET                           (webhook mock_gateway,
#                                                    bez verifikacije)
#   GA_MEASUREMENT_ID                               (nije povezano u kodu)
# Ne brisati ako planiraš koristiti; u suprotnom može da se ukloni.
# ============================================================================

# ----------------------------------------------------------------------------
# PRIMER per-servis konfiguracije (kako se mapira gornji skup)
# ----------------------------------------------------------------------------
# Netlify (Site settings → Environment variables / GitHub secrets):
#   SITE_URL, API_URL, ALERT_WEBHOOK_URL, NETLIFY_AUTH_TOKEN, SMTP_*, NETLIFY_SITE_ID
# API (Docker/systemd):
#   DATABASE_URL, REDIS_URL, JWT_SECRET, JWT_REFRESH_SECRET, NODE_ENV, PORT,
#   FRONTEND_URL, MEILI_HOST, MEILI_API_KEY
# CI (GitHub secrets):
#   NETLIFY_AUTH_TOKEN, NETLIFY_SITE_ID, TEST_DB, TEST_PORT
# ----------------------------------------------------------------------------